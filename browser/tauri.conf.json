{
  "productName": "Nexus",
  "version": "0.1.0",
  "identifier": "com.nexus.browser",
  "build": {
    "resourcesDir": "resources",
    "devPath": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "yarn workspace @nexus/browser dev",
    "beforeBuildCommand": "yarn workspace @nexus/browser build",
    "withGlobalTauri": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nexus Browser",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'"
    },
    "urls": {
      "scope": ["https://*", "http://*"]
    }
  }
}
