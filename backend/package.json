{
  "name": "@nexus/backend",
  "version": "0.1.0",
  "description": "Nexus Backend API — AI search engine",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/db/migration.ts",
    "db:seed": "tsx src/db/seed.ts",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {
    "fastify": "^4.25.0",
    "@fastify/cors": "^8.4.2",
    "@fastify/jwt": "^7.8.0",
    "@fastify/rate-limit": "^9.1.0",
    "@anthropic-ai/sdk": "^0.11.0",
    "groq-sdk": "^0.5.0",
    "openai": "^4.26.0",
    "qdrant-client": "^1.7.0",
    "pg": "^8.11.0",
    "redis": "^4.6.0",
    "bullmq": "^5.0.0",
    "zod": "^3.22.0",
    "@clerk/backend": "^0.32.0",
    "stripe": "^14.0.0",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.0",
    "typescript": "^5.3.0",
    "tsx": "^4.6.0",
    "eslint": "^8.48.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
